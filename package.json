{
  "name": "centplayer",
  "version": "0.1.0",
  "description": "A streaming-style React video player with content-aware controls, intro/outro skipping, episode navigation, and picture-in-picture.",
  "keywords": [
    "react",
    "video",
    "video-player",
    "player",
    "streaming",
    "picture-in-picture",
    "fullscreen"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist-lib/centplayer.cjs",
  "module": "./dist-lib/centplayer.js",
  "types": "./dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/centplayer.js",
      "require": "./dist-lib/centplayer.cjs"
    },
    "./style.css": {
      "types": "./dist-lib/centplayer.css.d.ts",
      "default": "./dist-lib/centplayer.css"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist-lib", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/copy-css-types.mjs",
    "build:demo": "tsc -b && vite build",
    "typecheck": "tsc -b --force && tsc -p tsconfig.build.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build:lib",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
